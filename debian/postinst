#!/bin/bash
set -e

CONFIG_DIR="/etc/pve-gic-manager"
mkdir -p "$CONFIG_DIR"

# 1. Setup shared cluster auth token
LOCAL_TOKEN="$CONFIG_DIR/auth.token"
CLUSTER_TOKEN="/etc/pve/pve-gic-token"

if [ -d "/etc/pve" ]; then
    if [ -f "$CLUSTER_TOKEN" ]; then
        cp -f "$CLUSTER_TOKEN" "$LOCAL_TOKEN" 2>/dev/null || true
    else
        if [ ! -f "$LOCAL_TOKEN" ]; then
            head -c 32 /dev/urandom | xxd -p -c 32 > "$LOCAL_TOKEN" 2>/dev/null || openssl rand -hex 32 > "$LOCAL_TOKEN"
        fi
        cp -f "$LOCAL_TOKEN" "$CLUSTER_TOKEN" 2>/dev/null || true
    fi
else
    if [ ! -f "$LOCAL_TOKEN" ]; then
        openssl rand -hex 32 > "$LOCAL_TOKEN" 2>/dev/null || date +%s%N | sha256sum | awk '{print $1}' > "$LOCAL_TOKEN"
    fi
fi
chmod 600 "$LOCAL_TOKEN" 2>/dev/null || true

# 2. Reload and start systemd service
if [ -d "/run/systemd/system" ]; then
    systemctl daemon-reload || true
    systemctl enable pve-gic-manager.service || true
    systemctl restart pve-gic-manager.service || true
fi

echo "================================================================="
echo " [OK] Proxmox VE ARM64 GIC Manager installed and started!"
echo "   - Web Management UI : http://<NODE-IP>:8005"
echo "   - Cluster Node API   : http://<NODE-IP>:8004"
echo "   - Service Status     : systemctl status pve-gic-manager"
echo "================================================================="

exit 0
